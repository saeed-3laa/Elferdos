{
  "name": "al-ferdous-wholesale",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deployment-gates": "node --test --test-concurrency=1 tests/deployment/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --config=playwright.live.config.ts",
    "db:start": "supabase start",
    "db:start:core": "supabase start --exclude realtime,imgproxy,studio,logflare,vector,supavisor,edge-runtime,postgres-meta",
    "images:cleanup": "node --env-file=.env.local scripts/cleanup-product-images.mjs",
    "db:env": "node scripts/configure-local-env.mjs",
    "test:local-auth": "node --env-file=.env.local scripts/test-local-auth.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "admin:bootstrap": "node --env-file=.env.local scripts/bootstrap-owner.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
