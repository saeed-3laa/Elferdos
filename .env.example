# Copy to .env.local. Obtain values from your DEVELOPMENT Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: privileged account/storage operations and shared quotas. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Existing Supabase Auth user UUID. Bootstrap does not create a fixed password.
BOOTSTRAP_OWNER_USER_ID=
# Required for production login/register. Random stable server-only secret, >=32 chars.
AUTH_RATE_LIMIT_SECRET=
# Optional: only set when your reverse proxy overwrites this IP header securely.
TRUSTED_CLIENT_IP_HEADER=
# Fixed public application origin; HTTPS in hosted environments. Never derive email
# confirmation destinations from a client-supplied Host/forwarded header.
APP_ORIGIN=
